# Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...
# Postgres connection. Local dev default matches docker-compose's db service.
# In cloud, point this at RDS. Driver is psycopg3 (postgresql+psycopg://).
DATABASE_URL=postgresql+psycopg://cvadapter:cvadapter@localhost:5432/cvadapter
DATA_DIR=data/profiles
JOB_STORE_DIR=data/job_store/jobs
APPLICATION_TRACKER_DIR=data/application_tracker
TA_CONFIG_DIR=data/ta_config
# Auth is on by default. Do not set AUTH_ENFORCED=false outside an explicitly
# marked local/test process; production startup rejects it.
AUTH_ENFORCED=true
# Set APP_ENV=production in every deployed environment. That is what turns
# "AUTH_ENFORCED=false is discouraged" into a hard startup failure.
APP_ENV=development
